<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".TambahUserActivity">

    <View android:id="@+id/headerBg" android:layout_width="0dp" android:layout_height="140dp"
        android:background="@color/role_admin"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnKembali"
        android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="16dp" android:layout_marginTop="32dp"
        android:backgroundTint="#33FFFFFF" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
        app:iconPadding="0dp" app:cornerRadius="21dp" app:icon="@drawable/icon_back" app:iconGravity="textStart" app:iconSize="20dp" app:iconTint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:rippleColor="#33FFFFFF" />

    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="44dp" android:text="Tambah User Baru" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/contentBg" android:layout_width="0dp" android:layout_height="0dp"
        android:background="@drawable/bg_rounded_top_white" android:layout_marginTop="-24dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/headerBg" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_nama"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp" android:layout_marginTop="24dp"
        android:hint="Nama Lengkap"
        app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp"
        app:startIconDrawable="@drawable/ic_user"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@+id/contentBg">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/edt_nama"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:imeOptions="actionNext" android:padding="16dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_username"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp" android:layout_marginTop="12dp"
        android:hint="Username"
        app:boxCornerRadiusBottomEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp"
        app:startIconDrawable="@drawable/ic_user"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/til_nama">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/edt_username"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="actionNext" android:padding="16dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_password"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp" android:layout_marginTop="12dp"
        android:hint="Password"
        app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
        app:startIconDrawable="@drawable/ic_lock" app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/til_username">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/edt_password"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:imeOptions="actionDone" android:padding="16dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:id="@+id/tvLabelRole" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="28dp" android:layout_marginTop="20dp"
        android:text="Pilih Role:" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/til_password" />

    <RadioGroup android:id="@+id/radioGroupRole"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp" android:layout_marginTop="8dp" android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/tvLabelRole">
        <RadioButton android:id="@+id/rbMurid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Murid" android:checked="true" android:textSize="16sp" />
        <RadioButton android:id="@+id/rbGuru" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Guru" android:textSize="16sp" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnSimpan"
        android:layout_width="0dp" android:layout_height="52dp"
        android:layout_marginHorizontal="28dp" android:layout_marginTop="32dp"
        android:backgroundTint="@color/primary" android:text="Simpan" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/radioGroupRole" app:rippleColor="#33FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
